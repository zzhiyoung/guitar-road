# 本地运行环境变量示例（复制为 .env.local 生效）
# 阶段 A 为单用户本地模式，全部可选。

# SQLite 文件路径（默认 data/guitar-practice.db）
# GUITAR_DB_PATH=./data/guitar-practice.db

# 乐谱 / 教材 PDF 存放目录（默认 data/files）
# GUITAR_FILES_DIR=./data/files

# 本地 owner 记录（写入 users 表，阶段 B 迁移 Supabase Auth 前的占位）
# GUITAR_OWNER_NAME=Guitarist
# GUITAR_OWNER_EMAIL=guitarist@example.com

# 独立构建目录（默认 .next；一键启动器只支持默认目录）
# GUITAR_NEXT_DIST_DIR=.next-preview

# ---- Creator 的可选 OMR 环境（不配置也能正常运行，Creator 会显示引擎未安装）----
# 指向装有 guitar_road_omr 的 Python 解释器（venv / conda）
# GUITAR_ROAD_OMR_PYTHON=C:/path/to/venv/Scripts/python.exe
# 覆盖 homr 的调用方式（JSON 数组），例如用 uvx
# GUITAR_ROAD_HOMR_CMD=["uvx", "--from", "homr[cpu]", "homr"]
# 额外透传给 homr 的参数（JSON 数组）
# GUITAR_ROAD_HOMR_ARGS=["--output-metronome", "90"]
# 推理设备：auto（默认，有 CUDA 就用）/ cpu / cuda
# GUITAR_ROAD_OMR_DEVICE=auto
